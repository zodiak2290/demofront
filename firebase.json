{
  "hosting": {
    "public": "dist/demoFront",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/coverage/**", "destination": "/coverage/index.html" },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
